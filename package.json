{
  "name": "rift-draft",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "test": "node --test",
    "check": "node scripts/check.mjs && eslint . && prettier --check .",
    "format": "prettier --write .",
    "smoke": "node scripts/build.mjs && node scripts/smoke-dist.mjs",
    "smoke:site": "node scripts/smoke-dist.mjs --site",
    "qa": "node scripts/qa-browser.mjs",
    "validate-data": "node scripts/validate-data.mjs",
    "lint": "eslint .",
    "evaluate": "node scripts/evaluate.mjs"
  },
  "engines": {
    "node": ">=20.11"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.9.10"
  }
}
